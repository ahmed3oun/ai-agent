# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Database Configuration (Docker PostgreSQL + pgvector)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=
FRONTEND_URL=


# AI Provider API Keys
GEMINI_API_KEY="your_google_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# LangSmith Observability & Tracing (Optional but highly recommended for portfolio)
LANGCHAIN_TRACING_V2=

LANGCHAIN_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_PROJECT=

# Server Ports
NEXT_PUBLIC_API_URL=
